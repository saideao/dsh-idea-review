{
  "name": "@local/dsh-idea-review",
  "version": "0.2.0",
  "private": true,
  "description": "Idea Review for DeepSeek Harness: literature survey + multi-model review for a research idea.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "skill/SKILL.md",
    "skill/references/*.md",
    "skill/scripts/*.py",
    "skill/assets/*",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "test/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
